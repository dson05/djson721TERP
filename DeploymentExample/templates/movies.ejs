<!doctype html>
<html lang="en">
    <head>
        <title>Movies</title>
        <meta charset="utf-8">
    </head>
    <body>
        <h1>Movies</h1>
        <% movies.forEach(movie => { %>
            <%= movie.name %> (<%= movie.year %>)<br>
        <% }); %>
        <p>Found: <%= movies.length %> movies</p>
        <p><a href="/">Home</a></p>
    </body>
</html>
